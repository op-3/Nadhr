+// Nadhr: uBlock Origin, bundled in the resource pak and loaded as a component
+// extension with ordinary (non-component) privileges; see
+// patches/nadhr/ublock/restrict-component-privileges.patch.
+void ComponentLoader::AddUBlock() {
+  Add(IDR_UBLOCK_MANIFEST_JSON, base::FilePath(FILE_PATH_LITERAL("ublock")));
+
+  ComponentExtensionInfo& info = component_extensions_.back();
+  std::string error;
+  if (!extension_l10n_util::LocalizeExtension(
+          info.root_directory, &info.manifest,
+          extension_l10n_util::GzippedMessagesPermission::kAllowForTrustedSource,
+          &error, /*is_component=*/true)) {
+    LOG(ERROR) << "Failed to localize uBlock Origin: " << error;
+  }
+}
